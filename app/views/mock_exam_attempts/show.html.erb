<%= content_for :page_meta do %>
  <title>Exam in Progress — <%= @template.title %> — <%= community_name %></title>
  <meta name="robots" content="noindex" />
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
  <style>
    .top-bar, .crayons-header, #page-content > footer, footer,
    .side-bar, .crayons-layout__sidebar-left, .stories-sidebar,
    .broadcast-wrapper, #runtime-banner-container,
    .crayons-layout__content nav { display: none !important; }
    html, body { margin: 0 !important; padding: 0 !important; overflow: hidden; height: 100%; }
    #page-content { padding: 0 !important; margin: 0 !important; max-width: 100% !important; height: 100%; }
    #page-content-inner { padding: 0 !important; margin: 0 !important; height: 100%; }
    .crayons-layout, .crayons-layout__content { padding: 0 !important; margin: 0 !important; max-width: 100% !important; }
    main { padding: 0 !important; margin: 0 !important; }
    @media (max-width: 768px) {
      body { overflow: hidden; -webkit-overflow-scrolling: touch; }
    }
  </style>
<% end %>

<div id="mock-exam-interface"
     data-props="<%= { slug: @template.slug, attemptId: @attempt.id }.to_json %>"></div>

<%= javascript_include_tag "mockExams", defer: true %>
