<%= content_for :page_meta do %>
  <title>Results — <%= @template.title %> — <%= community_name %></title>
  <meta name="robots" content="noindex" />
<% end %>

<div class="crayons-layout crayons-layout--limited-xl">
  <div class="crayons-layout__content">
    <div id="mock-exam-results" data-props="<%= { slug: @template.slug, attemptId: @attempt.id }.to_json %>"></div>
  </div>
</div>
<%= javascript_include_tag "mockExams", defer: true %>
