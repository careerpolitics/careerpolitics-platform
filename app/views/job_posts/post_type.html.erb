<% content_for :title, "#{@selected_post_type_label} - CareerPolitics" %>

<style>
  .jobs-page { font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background: linear-gradient(135deg, #f5f7fa, #e3e8f5); color: #1a1a1a; line-height: 1.5; min-height: 100vh; }
  .jobs-container { max-width: 900px; width: 92%; margin: 20px auto; padding: 10px; }
  .jobs-list-card { background: #fff; padding: 20px; border-radius: 12px; box-shadow: 0 6px 12px rgba(0,0,0,.05); border-left: 5px solid #0056b3; }
  .jobs-list-card h1 { color: #0056b3; margin-bottom: 16px; font-size: 1.6em; }
  .jobs-list-card ul { list-style: none; padding: 0; margin: 0; }
  .jobs-list-card li { padding: 10px 0; border-bottom: 1px solid #eee; }
  .jobs-list-card li:last-child { border-bottom: none; }
  .jobs-list-card a { color: #0056b3; text-decoration: none; }
  .jobs-list-card a:hover { color: #003d82; }
  .jobs-back-link { display: inline-block; margin-bottom: 14px; color: #003d82; text-decoration: none; font-weight: 600; }
  .jobs-pagination { margin-top: 18px; }
</style>

<main class="jobs-page">
  <section class="jobs-container">
    <%= link_to "← Back to Jobs Home", job_posts_path, class: "jobs-back-link" %>

    <section class="jobs-list-card">
      <h1><%= @selected_post_type_label %></h1>

      <ul>
        <% @job_posts.each do |job_post| %>
          <% link_url = job_post.link.presence || job_post_path(job_post.slug) %>
          <% link_url = link_url.start_with?('/') ? link_url : (link_url.start_with?('http') ? link_url : "/#{link_url}") %>
          <li>
            <a href="<%= link_url %>"><%= job_post.title %></a>
          </li>
        <% end %>
      </ul>

      <div class="jobs-pagination">
        <%= paginate @job_posts %>
      </div>
    </section>
  </section>
</main>
