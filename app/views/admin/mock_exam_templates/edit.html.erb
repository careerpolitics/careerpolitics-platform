<div class="crayons-card p-6">
  <div class="flex items-center justify-between mb-4">
    <h1 class="crayons-title">Edit: <%= @template.title %></h1>
    <div class="flex gap-2">
      <%= link_to "Show", admin_mock_exam_template_path(@template), class: "c-btn c-btn--secondary" %>
      <%= link_to "Back", admin_mock_exam_templates_path, class: "c-btn c-btn--secondary" %>
    </div>
  </div>

  <%= render "form", template: @template %>
</div>
