<div class="crayons-card p-6">
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="crayons-title mb-1">CP++ Subscribers</h1>
      <p class="color-base-60 m-0">Review Razorpay subscribers, status, and subscription actions.</p>
    </div>
  </div>

  <table class="crayons-table crayons-table--minimal w-100">
    <thead>
    <tr>
      <th scope="col">User</th>
      <th scope="col">Subscribed</th>
      <th scope="col">Status</th>
      <th scope="col">Razorpay subscription</th>
      <th scope="col">Actions</th>
    </tr>
    </thead>
    <tbody>
    <% @users.each do |user| %>
      <tr>
        <td>
          <a href="<%= admin_user_path(user) %>" class="c-link c-link--branded fw-bold"><%= user.username %></a>
          <p class="fs-s color-base-60 m-0"><%= user.email %></p>
        </td>
        <td>
          <% subscribed_at = @subscriber_role_dates[user.id]&.created_at %>
          <%= subscribed_at ? l(subscribed_at, format: :short) : "Unknown" %>
        </td>
        <td><%= user.current_subscriber_status %></td>
        <td><%= user.razorpay_subscription_id.presence || "—" %></td>
        <td>
          <div class="flex flex-col gap-2">
            <%= button_to "Cancel subscription",
                          cancel_admin_subscription_path(user),
                          method: :post,
                          class: "crayons-btn crayons-btn--danger crayons-btn--s",
                          data: { confirm: "Cancel this user's Razorpay subscription immediately?" },
                          disabled: user.razorpay_subscription_id.blank? %>

            <%= form_with(
                  url: refund_admin_subscription_path(user),
                  method: :post,
                  local: true,
                  class: "flex gap-2 items-center",
                  ) do |f| %>
              <%= f.text_field :payment_id,
                               placeholder: "Razorpay payment ID",
                               class: "crayons-textfield fs-s",
                               aria: { label: "Razorpay payment ID for #{user.username}" } %>
              <label class="fs-s whitespace-nowrap">
                <%= f.check_box :cancel_access, checked: true %>
                Remove access
              </label>
              <%= f.submit "Refund", class: "crayons-btn crayons-btn--secondary crayons-btn--s" %>
            <% end %>
          </div>
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>

  <% if @users.empty? %>
    <p class="align-center fs-l color-base-60 py-6">No subscribers found.</p>
  <% end %>

  <div class="flex justify-end mt-4">
    <%= paginate @users, theme: "admin", scope: @users, label: "Subscribers pagination" %>
  </div>
</div>
