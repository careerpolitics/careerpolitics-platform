<% title "CP++ Premium — #{community_name}" %>
<% cp_logo = Settings::General.logo_png.presence || URL.url(asset_path("icon.png")) %>

<div class="crayons-layout crayons-layout--limited-width crayons-layout--single-col">
  <%# ── Hero Section ── %>
  <div class="crayons-card crayons-card--content-rows p-6 mb-4">
    <div class="flex items-center mb-4">
      <img
        src="<%= asset_path("subscription-icon.png") %>"
        alt="CP++"
        width="64"
        height="42"
        class="mr-3 radius-default" />
      <div>
        <h1 class="crayons-title mb-0">CP++ Premium</h1>
        <p class="color-base-60 fs-s mb-0">Unlock your full exam preparation potential</p>
      </div>
    </div>
  </div>

  <%# ── Features Section ── %>
  <div class="crayons-card crayons-card--content-rows p-6 mb-4">
    <h2 class="crayons-subtitle-1 mb-4">What you get with CP++</h2>
    <div class="grid gap-4 m:grid-cols-2">
      <div class="flex items-start gap-3">
        <span class="crayons-icon crayons-icon--default" style="color: var(--accent-brand);">✓</span>
        <div>
          <p class="fw-bold mb-1">Unlimited Mock Exams</p>
          <p class="fs-s color-base-60 mb-0">Attempt every exam set as many times as you want, with no daily limits.</p>
        </div>
      </div>
      <div class="flex items-start gap-3">
        <span class="crayons-icon crayons-icon--default" style="color: var(--accent-brand);">✓</span>
        <div>
          <p class="fw-bold mb-1">Detailed Performance Analytics</p>
          <p class="fs-s color-base-60 mb-0">Track your progress with section-wise accuracy, percentiles, and trends.</p>
        </div>
      </div>
      <div class="flex items-start gap-3">
        <span class="crayons-icon crayons-icon--default" style="color: var(--accent-brand);">✓</span>
        <div>
          <p class="fw-bold mb-1">Augmented Content Preferences</p>
          <p class="fs-s color-base-60 mb-0">Personalize your feed with AI-powered content recommendations.</p>
        </div>
      </div>
      <div class="flex items-start gap-3">
        <span class="crayons-icon crayons-icon--default" style="color: var(--accent-brand);">✓</span>
        <div>
          <p class="fw-bold mb-1">Premium Badge</p>
          <p class="fs-s color-base-60 mb-0">Stand out in the community with a verified premium member badge.</p>
        </div>
      </div>
    </div>
  </div>

  <%# ── Plan Selection + CTA Section ── %>
  <div class="crayons-card crayons-card--content-rows p-6 mb-4">
    <h2 class="crayons-subtitle-1 mb-4">Choose your plan</h2>

    <div class="grid gap-4 m:grid-cols-2 mb-4">
      <% if @monthly_plan_id %>
        <label class="crayons-card p-4 cursor-pointer plan-option" style="border: 2px solid var(--accent-brand);">
          <input type="radio" name="plan_type" value="monthly" checked class="plan-radio hidden" />
          <div class="flex justify-between items-center mb-2">
            <span class="fw-bold fs-l">Monthly</span>
            <span class="crayons-tag crayons-tag--monochrome">Popular</span>
          </div>
          <p class="color-base-60 fs-s mb-0">Billed once. Access for one month.</p>
        </label>
      <% end %>
      <% if @yearly_plan_id %>
        <label class="crayons-card p-4 cursor-pointer plan-option" style="border: 2px solid transparent;">
          <input type="radio" name="plan_type" value="yearly" class="plan-radio hidden" />
          <div class="flex justify-between items-center mb-2">
            <span class="fw-bold fs-l">Yearly</span>
            <span class="crayons-tag crayons-tag--monochrome" style="background: var(--accent-brand); color: #fff;">Save more</span>
          </div>
          <p class="color-base-60 fs-s mb-0">Billed once. Access for one year.</p>
        </label>
      <% end %>
    </div>

    <div class="flex gap-3 items-center fw-wrap">
      <% unless current_user.cached_base_subscriber? %>
        <%= button_to "Start Free 7-Day Trial",
                      free_trial_subscriptions_path,
                      method: :post,
                      class: "crayons-btn crayons-btn--secondary" %>
      <% end %>
      <button
        id="razorpay-pay-btn"
        class="crayons-btn crayons-btn--brand"
        data-create-url="<%= subscriptions_path %>"
        data-confirm-url="<%= confirm_subscriptions_path %>"
        data-community-name="<%= j(community_name) %>"
        data-logo="<%= j(cp_logo) %>"
        data-csrf-token="<%= form_authenticity_token %>">
        Subscribe Now
      </button>
    </div>

    <p class="fs-s color-base-60 mt-4 mb-0">
      Powered by Razorpay. Supports UPI, Cards, NetBanking, and Wallets. Your payment details are fully encrypted and secure.
    </p>
  </div>

  <%# ── FAQ Section ── %>
  <div class="crayons-card crayons-card--content-rows p-6">
    <h2 class="crayons-subtitle-1 mb-4">Frequently Asked Questions</h2>
    <details class="mb-3">
      <summary class="fw-bold cursor-pointer">Can I try before I pay?</summary>
      <p class="color-base-70 mt-2 mb-0">Yes! Start a free 7-day trial with full access — no payment details required.</p>
    </details>
    <details class="mb-3">
      <summary class="fw-bold cursor-pointer">How do I cancel?</summary>
      <p class="color-base-70 mt-2 mb-0">Go to Settings → Billing → Manage Subscription. You can cancel anytime and retain access until the end of your billing period.</p>
    </details>
    <details class="mb-3">
      <summary class="fw-bold cursor-pointer">What payment methods are supported?</summary>
      <p class="color-base-70 mt-2 mb-0">We accept UPI, Credit/Debit Cards, NetBanking, and Wallets via Razorpay.</p>
    </details>
    <details>
      <summary class="fw-bold cursor-pointer">Will my subscription auto-renew?</summary>
      <p class="color-base-70 mt-2 mb-0">No, subscriptions are one-time payments. You'll need to manually renew when your plan period ends.</p>
    </details>
  </div>
</div>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
  (function() {
    var btn = document.getElementById('razorpay-pay-btn');
    if (!btn) return;

    var createUrl  = btn.dataset.createUrl;
    var confirmUrl = btn.dataset.confirmUrl;
    var communityName = btn.dataset.communityName;
    var logo = btn.dataset.logo;
    var csrfToken = btn.dataset.csrfToken;

    // Plan selection UI
    var planOptions = document.querySelectorAll('.plan-option');
    var planRadios = document.querySelectorAll('.plan-radio');
    planRadios.forEach(function(radio) {
      radio.addEventListener('change', function() {
        planOptions.forEach(function(opt) {
          opt.style.borderColor = 'transparent';
        });
        radio.closest('.plan-option').style.borderColor = 'var(--accent-brand)';
      });
    });

    function getSelectedPlanType() {
      var checked = document.querySelector('.plan-radio:checked');
      return checked ? checked.value : 'monthly';
    }

    btn.addEventListener('click', function(e) {
      e.preventDefault();
      btn.disabled = true;
      btn.textContent = 'Processing…';

      fetch(createUrl, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken,
        },
        body: JSON.stringify({ plan_type: getSelectedPlanType() }),
        credentials: 'same-origin',
      })
        .then(function(resp) { return resp.json(); })
        .then(function(data) {
          if (data.error) {
            alert(data.error);
            btn.disabled = false;
            btn.textContent = 'Subscribe Now';
            return;
          }

          var options = {
            key: data.razorpay_key_id,
            subscription_id: data.subscription_id,
            name: communityName,
            description: "'CP++ Premium Subscription'",
            image: logo,
            prefill: { name: data.user_name, email: data.user_email },
            notes: { user_id: String(data.user_id) },
            theme: { color: '#3b49df' },
            handler: function(response) {
              var form = document.createElement('form');
              form.method = 'POST';
              form.action = confirmUrl;
              form.style.display = 'none';

              var fields = {
                authenticity_token: csrfToken,
                razorpay_payment_id: response.razorpay_payment_id,
                razorpay_subscription_id: response.razorpay_subscription_id,
                razorpay_signature: response.razorpay_signature,
              };
              for (var key in fields) {
                var input = document.createElement('input');
                input.type = 'hidden';
                input.name = key;
                input.value = fields[key];
                form.appendChild(input);
              }
              document.body.appendChild(form);
              form.submit();
            },
            modal: {
              ondismiss: function() {
                btn.disabled = false;
                btn.textContent = 'Subscribe Now';
              }
            }
          };

          var rzp = new Razorpay(options);
          rzp.on('payment.failed', function(response) {
            alert('Payment failed: ' + response.error.description);
            btn.disabled = false;
            btn.textContent = 'Subscribe Now';
          });
          rzp.open();
        })
        .catch(function(err) {
          alert('Something went wrong. Please try again.');
          btn.disabled = false;
          btn.textContent = 'Subscribe Now';
        });
    });
  })();
</script>
