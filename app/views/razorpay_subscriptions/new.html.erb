<% title "Subscribe to CP++ — #{community_name}" %>
<% cp_logo = Settings::General.logo_png.presence || URL.url(asset_path("icon.png")) %>

<div class="crayons-layout crayons-layout--limited-width crayons-layout--single-col">
  <%# ── Page Header ── %>
  <div class="crayons-card crayons-card--content-rows p-6 mb-4">
    <h1 class="crayons-title mb-1">Subscribe to CP++</h1>
    <p class="color-base-60 mb-0">Select a plan and complete payment to activate your premium access.</p>
  </div>

  <%# ── Plan Selection ── %>
  <div class="crayons-card crayons-card--content-rows p-6 mb-4">
    <h2 class="crayons-subtitle-1 mb-4">Select a plan</h2>

    <div class="grid gap-4 m:grid-cols-2 mb-4">
      <% if @monthly_amount_paise.positive? %>
        <label class="crayons-card p-5 cursor-pointer plan-option" style="border: 2px solid var(--accent-brand);">
          <input type="radio" name="plan_type" value="monthly" checked class="plan-radio hidden"
                 data-amount="<%= @monthly_plan_amount %>" data-period="month" />
          <div class="flex justify-between items-center mb-2">
            <span class="fw-bold fs-l">Monthly</span>
            <span class="crayons-tag crayons-tag--monochrome">Popular</span>
          </div>
          <p class="fs-3xl fw-heavy mb-1" style="color: var(--accent-brand);"><%= @monthly_plan_amount %><span class="fs-s fw-normal color-base-60"> / month</span></p>
          <ul class="fs-s color-base-60 list-disc pl-5 mb-0">
            <li>One-time payment — no auto-renewal</li>
            <li>Full premium access for 1 month</li>
          </ul>
        </label>
      <% end %>
      <% if @yearly_amount_paise.positive? %>
        <label class="crayons-card p-5 cursor-pointer plan-option" style="border: 2px solid transparent;">
          <input type="radio" name="plan_type" value="yearly" class="plan-radio hidden"
                 data-amount="<%= @yearly_plan_amount %>" data-period="year" />
          <div class="flex justify-between items-center mb-2">
            <span class="fw-bold fs-l">Yearly</span>
            <span class="crayons-tag crayons-tag--monochrome" style="background: var(--accent-brand); color: #fff;">Best value</span>
          </div>
          <p class="fs-3xl fw-heavy mb-1" style="color: var(--accent-brand);"><%= @yearly_plan_amount %><span class="fs-s fw-normal color-base-60"> / year</span></p>
          <ul class="fs-s color-base-60 list-disc pl-5 mb-0">
            <li>One-time payment — no auto-renewal</li>
            <li>Full premium access for 12 months</li>
          </ul>
        </label>
      <% end %>
    </div>
  </div>

  <%# ── Order Summary ── %>
  <div class="crayons-card crayons-card--content-rows p-6 mb-4">
    <h2 class="crayons-subtitle-1 mb-3">Order summary</h2>
    <div class="flex justify-between items-center mb-2">
      <span class="color-base-70">Plan</span>
      <span class="fw-bold" id="summary-plan">Monthly</span>
    </div>
    <div class="flex justify-between items-center mb-2">
      <span class="color-base-70">Amount</span>
      <span class="fw-bold" id="summary-amount"><%= @monthly_plan_amount || @yearly_plan_amount %></span>
    </div>
    <div class="flex justify-between items-center mb-3">
      <span class="color-base-70">Billing</span>
      <span class="fs-s">One-time — does not auto-renew</span>
    </div>
    <hr class="mb-3" />

    <div class="flex gap-3 items-center fw-wrap">
      <button
        id="razorpay-pay-btn"
        class="crayons-btn crayons-btn--brand"
        data-create-url="<%= subscriptions_path %>"
        data-confirm-url="<%= confirm_subscriptions_path %>"
        data-community-name="<%= j(community_name) %>"
        data-logo="<%= j(cp_logo) %>"
        data-csrf-token="<%= form_authenticity_token %>">
        Pay &amp; Subscribe
      </button>
      <% unless current_user.cached_base_subscriber? %>
        <%= button_to "Start Free 7-Day Trial Instead",
                      free_trial_subscriptions_path,
                      method: :post,
                      class: "crayons-btn crayons-btn--secondary" %>
      <% end %>
    </div>
  </div>

  <%# ── Billing Details ── %>
  <div class="crayons-card crayons-card--content-rows p-6">
    <h2 class="crayons-subtitle-2 mb-3">Billing details</h2>
    <ul class="fs-s color-base-70 list-disc pl-5 mb-3">
      <li>Your subscription is a <strong>one-time payment</strong> — it will not auto-renew.</li>
      <li>Premium access activates instantly after successful payment.</li>
      <li>Access expires at the end of your plan period (1 month or 12 months).</li>
      <li>You can renew manually from Settings → Billing when your plan ends.</li>
      <li>Cancellation and refund requests can be made from Settings → Billing → Manage Subscription.</li>
    </ul>
    <p class="fs-xs color-base-50 mb-0">
      Payments processed securely by Razorpay. Supports UPI, Credit/Debit Cards, NetBanking, and Wallets.
    </p>
  </div>
</div>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
  (function() {
    var btn = document.getElementById('razorpay-pay-btn');
    if (!btn) return;

    var createUrl  = btn.dataset.createUrl;
    var confirmUrl = btn.dataset.confirmUrl;
    var communityName = btn.dataset.communityName;
    var logo = btn.dataset.logo;
    var csrfToken = btn.dataset.csrfToken;

    // Plan selection UI + order summary sync
    var planOptions = document.querySelectorAll('.plan-option');
    var planRadios = document.querySelectorAll('.plan-radio');
    var summaryPlan = document.getElementById('summary-plan');
    var summaryAmount = document.getElementById('summary-amount');
    var planLabels = { monthly: 'Monthly', yearly: 'Yearly' };

    function syncSummary(radio) {
      planOptions.forEach(function(opt) { opt.style.borderColor = 'transparent'; });
      radio.closest('.plan-option').style.borderColor = 'var(--accent-brand)';
      if (summaryPlan) summaryPlan.textContent = planLabels[radio.value] || radio.value;
      if (summaryAmount) summaryAmount.textContent = radio.dataset.amount || '';
    }

    planRadios.forEach(function(radio) {
      radio.addEventListener('change', function() { syncSummary(radio); });
    });

    function getSelectedPlanType() {
      var checked = document.querySelector('.plan-radio:checked');
      return checked ? checked.value : 'monthly';
    }

    btn.addEventListener('click', function(e) {
      e.preventDefault();
      btn.disabled = true;
      btn.textContent = 'Processing…';

      fetch(createUrl, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken,
        },
        body: JSON.stringify({ plan_type: getSelectedPlanType() }),
        credentials: 'same-origin',
      })
        .then(function(resp) { return resp.json(); })
        .then(function(data) {
          if (data.error) {
            alert(data.error);
            btn.disabled = false;
            btn.textContent = 'Pay & Subscribe';
            return;
          }

          var options = {
            key: data.key_id,
            order_id: data.order_id,
            amount: data.amount,
            currency: data.currency,
            name: communityName,
            description: 'CP++ Premium Subscription',
            image: logo,
            prefill: { name: data.user_name, email: data.user_email },
            notes: { user_id: String(data.user_id) },
            theme: { color: '#3b49df' },
            handler: function(response) {
              var form = document.createElement('form');
              form.method = 'POST';
              form.action = confirmUrl;
              form.style.display = 'none';

              var fields = {
                authenticity_token: csrfToken,
                razorpay_payment_id: response.razorpay_payment_id,
                razorpay_order_id: response.razorpay_order_id,
                razorpay_signature: response.razorpay_signature,
                plan_type: getSelectedPlanType(),
              };
              for (var key in fields) {
                var input = document.createElement('input');
                input.type = 'hidden';
                input.name = key;
                input.value = fields[key];
                form.appendChild(input);
              }
              document.body.appendChild(form);
              form.submit();
            },
            modal: {
              ondismiss: function() {
                btn.disabled = false;
                btn.textContent = 'Pay & Subscribe';
              }
            }
          };

          var rzp = new Razorpay(options);
          rzp.on('payment.failed', function(response) {
            alert('Payment failed: ' + response.error.description);
            btn.disabled = false;
            btn.textContent = 'Pay & Subscribe';
          });
          rzp.open();
        })
        .catch(function(err) {
          alert('Something went wrong. Please try again.');
          btn.disabled = false;
          btn.textContent = 'Pay & Subscribe';
        });
    });
  })();
</script>
