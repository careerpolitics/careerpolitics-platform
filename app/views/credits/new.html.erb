<% title t("views.credits.new.meta.title") %>

<div class="credits-container">
  <div class="credits-banner">
    <h1><%= t("views.credits.new.heading", name: @purchaser.username) %></h1>

    <% if @organizations %>
      <% @organizations.each do |org| %>
        <% unless @purchaser.id == org.id %>
          <a href="/credits/purchase?organization_id=<%= org.id %>" data-no-instant><%= t("views.credits.new.switch.org", name: org.name) %></a>
        <% end %>
      <% end %>
    <% end %>
    <% unless @purchaser.is_a? User %>
      <a href="/credits/purchase" data-no-instant><%= t("views.credits.new.switch.user") %></a>
    <% end %>
  </div>

  <% if flash[:error].present? %>
    <div class="crayons-card crayons-card--secondary crayons-notice crayons-notice--danger" role="alert">
      <p><%= flash[:error] %></p>
    </div>
  <% end %>

  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>

  <div style="margin-top: 30px; text-align: center">
    <%= render "pricing" %>

    <%= render "purchase_faq" %>
    <details>
      <summary>
        <%= params[:organization_id].present? ? t("views.credits.new.status.subtitle.org", name: @purchaser.name) : t("views.credits.new.status.subtitle.user") %>
      </summary>
      <div>
        <p>
          <% count = @purchaser.credits.where(spent: false).size %>
          <%= params[:organization_id].present? ? t("views.credits.new.status.desc.org", name: @purchaser.name, count: count) : t("views.credits.new.status.desc.user", count: count) %>
        </p>
      </div>
    </details>
    <details>
      <summary>
        <%= t("views.credits.new.how.subtitle") %>
      </summary>
      <div>
        <p>
          <%= t("views.credits.new.how.desc_html") %>
        </p>
      </div>
    </details>

    <div class="credit-purchase-form">
      <label for="amount-input" class="main-form-label">
        <%= t("views.credits.new.form.amount.label") %>
      </label>
      <div class="amount-wrapper">
        <input type="number" id="amount-input"
               placeholder="<%= t("views.credits.new.form.amount.placeholder") %>"
               autocomplete="off" min="1" max="10000000" required />
        <div id="calculated-price"></div>
      </div>

      <div id="payment-errors" class="crayons-notice crayons-notice--danger" role="alert" style="display:none;"></div>

      <button id="buy-credits-button" class="credit-card-button">
        <%= t("views.credits.new.form.submit") %>
      </button>

      <% if @purchaser.is_a? Organization %>
        <p><em><%= t("views.credits.new.form.note_org") %></em></p>
      <% end %>
    </div>
  </div>
</div>

<script>
  (function() {
    var createOrderUrl = '<%= create_order_credits_path %>';
    var fulfillUrl = '<%= credits_path %>';
    var csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
    var organizationId = '<%= @purchaser.is_a?(Organization) ? @purchaser.id : "" %>';
    var razorpayKeyId = '<%= @razorpay_key_id %>';
    var userName = '<%= current_user.name %>';
    var userEmail = '<%= current_user.email %>';
    var communityName = '<%= community_name %>';

    var buyButton = document.getElementById('buy-credits-button');
    var amountInput = document.getElementById('amount-input');
    var errorsDiv = document.getElementById('payment-errors');

    function showError(msg) {
      errorsDiv.textContent = msg;
      errorsDiv.style.display = 'block';
    }

    function hideError() {
      errorsDiv.style.display = 'none';
    }

    buyButton.addEventListener('click', function(e) {
      e.preventDefault();
      hideError();

      var creditsCount = parseInt(amountInput.value, 10);
      if (!creditsCount || creditsCount < 1) {
        showError('Please enter a valid number of credits.');
        return;
      }

      buyButton.disabled = true;
      buyButton.textContent = '<%= t("views.credits.new.form.submitting") %>';

      // Step 1: Create a Razorpay Order on the server
      fetch(createOrderUrl, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken
        },
        body: JSON.stringify({
          credits_count: creditsCount,
          organization_id: organizationId || undefined
        })
      })
        .then(function(resp) { return resp.json(); })
        .then(function(data) {
          if (data.error) {
            showError(data.error);
            buyButton.disabled = false;
            buyButton.textContent = '<%= t("views.credits.new.form.submit") %>';
            return;
          }

          // Step 2: Open Razorpay Checkout
          var options = {
            key: razorpayKeyId,
            amount: data.amount,
            currency: data.currency,
            name: communityName,
            description: creditsCount + ' Credits',
            order_id: data.order_id,
            prefill: {
              name: userName,
              email: userEmail
            },
            handler: function(response) {
              // Step 3: Submit payment details to server for verification
              var form = document.createElement('form');
              form.method = 'POST';
              form.action = fulfillUrl;

              var fields = {
                razorpay_payment_id: response.razorpay_payment_id,
                razorpay_order_id: response.razorpay_order_id,
                razorpay_signature: response.razorpay_signature,
                credits_count: creditsCount,
                organization_id: organizationId,
                authenticity_token: csrfToken
              };

              for (var key in fields) {
                if (fields[key]) {
                  var input = document.createElement('input');
                  input.type = 'hidden';
                  input.name = key;
                  input.value = fields[key];
                  form.appendChild(input);
                }
              }

              document.body.appendChild(form);
              form.submit();
            },
            modal: {
              ondismiss: function() {
                buyButton.disabled = false;
                buyButton.textContent = '<%= t("views.credits.new.form.submit") %>';
              }
            }
          };

          var rzp = new Razorpay(options);
          rzp.on('payment.failed', function(resp) {
            showError(resp.error.description || 'Payment failed. Please try again.');
            buyButton.disabled = false;
            buyButton.textContent = '<%= t("views.credits.new.form.submit") %>';
          });
          rzp.open();
        })
        .catch(function(err) {
          showError('Something went wrong. Please try again.');
          buyButton.disabled = false;
          buyButton.textContent = '<%= t("views.credits.new.form.submit") %>';
        });
    });

    // Price calculator
    function getAmount(multiple) {
      var value = parseInt(amountInput.value, 10) || 0;
      var pricePer = 0;
      if (value < 10) {
        pricePer = 5;
      } else if (value < 100) {
        pricePer = 4;
      } else if (value < 1000) {
        pricePer = 3;
      } else {
        pricePer = 2.5;
      }
      return { value: value * pricePer * multiple, pricePer: pricePer };
    }

    function calculatePriceAndShow() {
      setTimeout(function() {
        var result = getAmount(1.0);
        document.getElementById('calculated-price').innerHTML =
          '₹' + result.value + ' (₹' + result.pricePer + '/each)';
      }, 100);
    }

    // Handle credit-price quick-select buttons
    var priceEls = document.getElementsByClassName('credit-price');
    for (var i = 0; i < priceEls.length; i++) {
      priceEls[i].onclick = function(e) {
        amountInput.value = e.target.dataset.num;
        calculatePriceAndShow();
      };
    }

    amountInput.addEventListener('input', calculatePriceAndShow);
  })();
</script>
